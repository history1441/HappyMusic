# HappyMusic 分布式部署配置模板
# 将此文件复制到每台服务器，修改对应变量

# ============================================
# 共享基础设施（MySQL + Redis）
# ============================================
# 这些地址在所有服务器上相同，指向共享基础设施

# MySQL 地址（所有 backend 实例共用）
MYSQL_HOST=10.0.0.100
MYSQL_PORT=3306
MYSQL_USER=happymusic
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=happymusic

# Redis 地址（缓存 + WebSocket 广播通道）
REDIS_HOST=10.0.0.100
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================================
# JWT 认证（所有 backend 必须使用相同密钥）
# ============================================
JWT_SECRET_KEY=your_jwt_secret_key_change_this
JWT_ALGORITHM=HS256

# ============================================
# 后端实例配置（每台 backend 服务器不同）
# ============================================
# 实例 ID：用于区分不同服务器上的 backend
INSTANCE_ID=backend-server-1

# WebSocket 广播频道（所有实例共用同一频道）
WS_BROADCAST_CHANNEL=happymusic:ws:broadcast

# ============================================
# 前端访问地址（用于客户端连接）
# ============================================
# 对外暴露的后端地址（Nginx LB 的公网/IP + 端口）
BACKEND_PUBLIC_URL=http://music.example.com:8080

# ============================================
# AI 配置（按需）
# ============================================
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-3.5-turbo

# ============================================
# 调试开关（生产环境必须关闭）
# ============================================
HAPPYMUSIC_DEBUG=false

# ============================================
# CORS 白名单（生产环境必须配置实际域名,逗号分隔）
# 留空 + HAPPYMUSIC_DEBUG=false 会拒绝所有跨域请求
# ============================================
ALLOWED_ORIGINS=https://music.example.com,https://admin.music.example.com
